# Configure estas variaveis em Environment no servico Web do Render.
# PORT e definido pelo Render; nao precisa cadastra-lo manualmente.
Database__Provider=postgresql
ConnectionStrings__DefaultConnection=Host=SEU_HOST_RDS;Port=5432;Database=solidarsys;Username=SEU_USUARIO;Password=SUA_SENHA;SSL Mode=VerifyFull;Root Certificate=/etc/secrets/rds-ca.pem

Jwt__SecretKey=GERE_UMA_CHAVE_ALEATORIA_COM_PELO_MENOS_32_CARACTERES
Jwt__Issuer=SolidarSYS
Jwt__Audience=SolidarSYS-Users
Jwt__AccessTokenExpirationMinutes=15
Jwt__RefreshTokenExpirationDays=7

Email__Host=smtp.gmail.com
Email__Port=587
Email__UseSsl=false
Email__Username=SEU_EMAIL
Email__Password=SUA_SENHA_DE_APP_GMAIL
Email__NomeRemetente=SolidarSYS
Email__UrlFrontend=https://SEU_FRONTEND.onrender.com
App__FrontendUrl=https://SEU_FRONTEND.onrender.com